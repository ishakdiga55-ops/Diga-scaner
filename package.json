{
  "name": "diga-scaner",
  "version": "0.4.0",
  "description": "CheckDiga Pro — تطبيق فحص أعطال السيارات عبر OBD2 (PWA)",
  "author": "Ishak Diga",
  "license": "MIT",
  "homepage": "https://ishakdiga55-ops.github.io/Diga-scaner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishakdiga55-ops/Diga-scaner.git"
  },
  "bugs": {
    "url": "https://github.com/ishakdiga55-ops/Diga-scaner/issues"
  },
  "keywords": [
    "obd2",
    "elm327",
    "diagnostics",
    "car",
    "dtc",
    "pwa",
    "web-bluetooth",
    "arabic"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\""
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.2.5",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
